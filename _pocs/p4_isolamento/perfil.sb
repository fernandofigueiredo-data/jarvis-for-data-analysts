(version 1)
(deny default)
(import "system.sb")
(allow process-fork)
(allow process-exec (subpath "/Users/fernandofigueiredo/.local/share/uv/python") (subpath "/Users/fernandofigueiredo/Documents/projetos/Jarvis/_pocs/.venv") (literal "/bin/sh") (literal "/bin/echo"))
(allow file-read*
  (subpath "/System") (subpath "/usr") (subpath "/Library/Apple") (subpath "/private/var/db/dyld") (subpath "/bin")
  (literal "/") (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random")
  (subpath "/Users/fernandofigueiredo/.local/share/uv/python")
  (subpath "/Users/fernandofigueiredo/Documents/projetos/Jarvis/_pocs/.venv")
  (subpath "/Users/fernandofigueiredo/Documents/projetos/Jarvis/_pocs/p4_isolamento/permitido"))
(allow file-read-metadata)
(allow file-write* (literal "/dev/null"))
(allow sysctl-read)
