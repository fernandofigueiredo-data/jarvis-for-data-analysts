# Configuração do Jarvis. Copie para .env (o /instalar faz isso) e mude só o que precisar.
# Toda linha é opcional: sem ela vale o padrão mostrado. As que começam com "# " ficam desligadas;
# tire o "# " e preencha para usar.

# --- Você ---
# Seu nome, usado no prompt ("assistente pessoal de voz da Ana")
JARVIS_NOME=
# Como o Jarvis fala com você: senhor, senhora ou nenhum
JARVIS_TRATAMENTO=senhor
# Cidade do clima; vazio = descobre pelo IP
JARVIS_LOCATION=

# --- Cérebro (Claude, pelo login do Claude Code; não precisa de chave) ---
JARVIS_MODEL=claude-sonnet-5-5
# low, medium ou high: mais esforço = respostas mais pensadas e mais lentas
JARVIS_EFFORT=low
JARVIS_MAX_TURNS=24
# 1 libera ações que mudam o mundo (terminal, escrever arquivos, enviar). O mesmo que --writes
# JARVIS_ALLOW_WRITES=

# --- Voz ---
# Modelo do Whisper: tiny, base, small (padrão, ~460 MB) ou medium (melhor, pede 16 GB de RAM)
JARVIS_WHISPER_MODEL=small
# Voz do macOS em pt-BR (Ajustes do Sistema › Acessibilidade › Conteúdo Falado › Voz do Sistema)
JARVIS_VOICE=Luciana
# Voz da ElevenLabs no lugar da do macOS: ponha ELEVENLABS_API_KEY aqui ou no Keychain
# ELEVENLABS_API_KEY=
# JARVIS_ELEVEN_VOICE_ID=

# --- Dados (CSV) ---
# Pastas onde "abre o arquivo X" procura, separadas por ":" (até três níveis abaixo de cada uma)
JARVIS_PASTAS_DADOS=~/Downloads:~/Documents:~/Desktop
# Grupos com menos linhas que isto nunca vão para o Claude
JARVIS_K_ANONIMATO=5
# Tamanho máximo de um arquivo arrastado para o painel
JARVIS_UPLOAD_MAX_MB=1024
# Python isolado: limites por execução (CPU em segundos, prazo em segundos, memória em MB)
JARVIS_PY_CPU_S=30
JARVIS_PY_PRAZO_S=60
JARVIS_PY_MEM_MB=1536
# Monitores de KPI: intervalo entre conferências, em minutos
JARVIS_KPI_INTERVALO_MIN=60

# --- Análise profunda (plugin analise-dados) ---
# Caminho do plugin; vazio = o instalado pelo Claude Code
# JARVIS_PLUGIN_ANALISE=
JARVIS_PASTA_ANALISES=~/Documents/Análises Jarvis
JARVIS_EFFORT_PROFUNDO=medium
# 0 = não abre o notebook no navegador
JARVIS_ABRIR_NOTEBOOK=1

# --- Notícias ---
# Intervalo entre buscas nas fontes de sources.json, em segundos
JARVIS_NEWS_INTERVAL=1200
# Horário do resumo diário falado (HH:MM); vazio desliga
JARVIS_RESUMO_HORA=08:00
# Temas que sobem no ranking do resumo, separados por vírgula
JARVIS_NOTICIAS_TEMAS=análise de dados, ciência de dados, engenharia de dados, SQL, pandas, DuckDB, dbt, Power BI, Databricks, analytics, dashboard, BI, estatística, LLM

# --- Técnico ---
JARVIS_PORT=8787
# Onde ficam banco, cache e arquivos enviados; desligado = data/ e cache/ dentro do repositório
# JARVIS_DATA_DIR=
# JARVIS_CACHE_DIR=
